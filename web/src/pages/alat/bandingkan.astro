---
import BookLayout from "../../layouts/BookLayout.astro";
import manifest from "../../../public/book-commits.json";

const { repo, branch, head, paths, commits } = manifest;
const title = "Bandingkan versi";
---

<BookLayout title={`${title} — booklet`} description="Bandingkan book.txt / book.yaml antar commit git.">
  <main class="compare-page">
    <header class="head">
      <a class="back" href="/daftar">← Daftar isi</a>
      <h1>{title}</h1>
      <p class="lede">
        Pilih dua commit — diff seperti <code>git diff</code>. File diambil dari GitHub
        (<code>raw.githubusercontent.com</code>), jadi commit harus sudah ter-push ke repo
        <code>{repo}</code>. Daftar commit dari build ini (HEAD <code>{head.slice(0, 7)}</code>).
      </p>
    </header>

    <form id="compare-form" class="panel" autocomplete="off">
      <div class="row">
        <label class="field">
          <span class="label">Dari (lama)</span>
          <select id="from-ref" name="from" required>
            {commits.map((c) => (
              <option value={c.sha}>
                {c.short} · {c.date.slice(0, 10)} · [{c.files.join(", ") || "—"}] {c.subject}
              </option>
            ))}
          </select>
        </label>
        <button type="button" class="swap" id="swap-refs" title="Tukar dari / ke" aria-label="Tukar commit">
          ⇄
        </button>
        <label class="field">
          <span class="label">Ke (baru)</span>
          <select id="to-ref" name="to" required>
            {commits.map((c) => (
              <option value={c.sha}>
                {c.short} · {c.date.slice(0, 10)} · [{c.files.join(", ") || "—"}] {c.subject}
              </option>
            ))}
          </select>
        </label>
      </div>

      <fieldset class="scope">
        <legend>File</legend>
        <label class="radio">
          <input type="radio" name="scope" value="txt" checked />
          book.txt
        </label>
        <label class="radio">
          <input type="radio" name="scope" value="yaml" />
          book.yaml
        </label>
        <label class="radio">
          <input type="radio" name="scope" value="all" />
          Keduanya
        </label>
      </fieldset>

      <button type="submit" class="submit">Bandingkan</button>
    </form>

    <p id="compare-status" class="status" role="status" hidden></p>
    <div id="compare-output" class="output" hidden></div>
  </main>
</BookLayout>

<script define:vars={{ repo, branch, paths, commits, head }}>
  import { createTwoFilesPatch } from "diff";

  const form = document.getElementById("compare-form");
  const fromSel = document.getElementById("from-ref");
  const toSel = document.getElementById("to-ref");
  const swapBtn = document.getElementById("swap-refs");
  const statusEl = document.getElementById("compare-status");
  const outputEl = document.getElementById("compare-output");

  function setDefaults() {
    if (commits.length < 2) return;
    toSel.value = commits[0].sha;
    fromSel.value = commits[1].sha;
    applyQueryParams();
  }

  function applyQueryParams() {
    const q = new URLSearchParams(location.search);
    const from = q.get("from");
    const to = q.get("to");
    const scope = q.get("scope");
    if (from && [...fromSel.options].some((o) => o.value === from)) fromSel.value = from;
    if (to && [...toSel.options].some((o) => o.value === to)) toSel.value = to;
    if (scope) {
      const input = form.querySelector(`input[name="scope"][value="${scope}"]`);
      if (input) input.checked = true;
    }
    if (q.get("run") === "1") form.requestSubmit();
  }

  function pushQuery(from, to, scope) {
    const q = new URLSearchParams({ from, to, scope, run: "1" });
    history.replaceState(null, "", `${location.pathname}?${q}`);
  }

  function rawUrl(sha, relPath) {
    return `https://raw.githubusercontent.com/${repo}/${sha}/${relPath}`;
  }

  async function fetchText(sha, relPath) {
    const res = await fetch(rawUrl(sha, relPath));
    if (!res.ok) throw new Error(`${relPath} @ ${sha.slice(0, 7)}: HTTP ${res.status}`);
    return res.text();
  }

  function escapeHtml(s) {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  }

  function renderPatch(title, patch) {
    if (!patch.trim()) {
      return `<section class="diff-block"><h2 class="diff-title">${escapeHtml(title)}</h2><p class="empty-diff">Tidak ada perbedaan.</p></section>`;
    }
    const lines = patch.split("\n").map((line) => {
      let cls = "ctx";
      if (line.startsWith("+++") || line.startsWith("---")) cls = "meta";
      else if (line.startsWith("@@")) cls = "hunk";
      else if (line.startsWith("+")) cls = "add";
      else if (line.startsWith("-")) cls = "del";
      return `<span class="line ${cls}">${escapeHtml(line)}</span>`;
    });
    return `<section class="diff-block"><h2 class="diff-title">${escapeHtml(title)}</h2><pre class="diff-pre">${lines.join("\n")}</pre></section>`;
  }

  async function runCompare() {
    const from = fromSel.value;
    const to = toSel.value;
    const scope = new FormData(form).get("scope") || "txt";
    pushQuery(from, to, scope);

    statusEl.hidden = false;
    statusEl.textContent = "Memuat…";
    outputEl.hidden = true;
    outputEl.innerHTML = "";

    const rels =
      scope === "yaml" ? [paths.yaml] : scope === "all" ? [paths.txt, paths.yaml] : [paths.txt];

    try {
      const blocks = [];
      for (const rel of rels) {
        const [oldText, newText] = await Promise.all([
          fetchText(from, rel),
          fetchText(to, rel),
        ]);
        const name = rel.split("/").pop();
        const patch = createTwoFilesPatch(
          `a/${name}`,
          `b/${name}`,
          oldText,
          newText,
          from.slice(0, 7),
          to.slice(0, 7),
          { context: 3 },
        );
        blocks.push(renderPatch(`${name}  ${from.slice(0, 7)} → ${to.slice(0, 7)}`, patch));
      }
      outputEl.innerHTML = blocks.join("");
      outputEl.hidden = false;
      statusEl.textContent = "Selesai.";
    } catch (err) {
      statusEl.textContent = err?.message || "Gagal memuat diff.";
    }
  }

  swapBtn?.addEventListener("click", () => {
    const t = fromSel.value;
    fromSel.value = toSel.value;
    toSel.value = t;
  });

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    runCompare();
  });

  setDefaults();
</script>

<style>
  .compare-page {
    width: min(100%, 42rem);
    margin: 0 auto;
    padding: var(--pad-y) var(--pad-x) calc(3rem + var(--safe-bottom));
  }

  .head {
    margin-bottom: 1.75rem;
  }

  .back {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-faint);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    font-size: var(--fs-title);
    margin-bottom: 0.5rem;
  }

  .lede {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .lede code {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.88em;
  }

  .panel {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.35);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.5rem;
    align-items: end;
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: 1fr;
    }
    .swap {
      justify-self: center;
    }
  }

  .field {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .label {
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink-soft);
  }

  select {
    width: 100%;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--bg);
    color: var(--ink);
  }

  .swap {
    font-family: var(--font-ui);
    font-size: 1.1rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--accent);
    cursor: pointer;
    margin-bottom: 0.1rem;
  }

  .swap:hover {
    background: var(--accent-soft);
  }

  .scope {
    border: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .scope legend {
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink-soft);
    width: 100%;
    margin-bottom: 0.15rem;
  }

  .radio {
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
  }

  .submit {
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.75rem 1.25rem;
    border: none;
    border-radius: 999px;
    background: var(--accent);
    color: #f8f6f0;
    cursor: pointer;
    justify-self: start;
  }

  .submit:hover {
    filter: brightness(1.05);
  }

  .status {
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-faint);
  }

  .output {
    margin-top: 1.25rem;
    display: grid;
    gap: 1.5rem;
  }

  .diff-title {
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }

  .diff-pre {
    margin: 0;
    padding: 0.75rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: #faf7f0;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.72rem;
    line-height: 1.45;
    white-space: pre;
  }

  .diff-pre .line {
    display: block;
  }

  .diff-pre .add {
    background: rgba(47, 93, 86, 0.14);
  }

  .diff-pre .del {
    background: rgba(160, 70, 50, 0.12);
  }

  .diff-pre .hunk {
    color: var(--accent);
  }

  .diff-pre .meta {
    color: var(--ink-faint);
  }

  .empty-diff {
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-faint);
    font-style: italic;
  }
</style>
